{
	"schemaVersion": 1,
	"id": "lavacan",
	"version": "${version}",
	"name": "Lava Can",
	"description": "Destroy unwanted items by dropping them onto a Lava Bucket. Fire-resistant items and a configurable exclusion list keep your valuables safe.",
	"authors": [
		"tapm"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/lavacan",
		"sources": "https://github.com/tapm/lavacan",
		"issues": "https://github.com/tapm/lavacan/issues"
	},
	"license": "MIT",
	"icon": "assets/lavacan/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"tapm.lavacan.LavaCan"
		],
		"client": [
			"tapm.lavacan.client.LavaCanClient"
		]
	},
	"mixins": [
		"lavacan.mixins.json",
		{
			"config": "lavacan.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.2-",
		"java": ">=25",
		"fabric-api": "*"
	}
}